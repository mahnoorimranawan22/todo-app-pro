# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# MongoDB Atlas (free tier):  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/todoapp
# Local MongoDB / Docker:     mongodb://127.0.0.1:27017/todoapp
MONGODB_URI=mongodb://127.0.0.1:27017/todoapp

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Emails (Resend) ---
# Get an API key at https://resend.com/api-keys (free tier). Without it,
# verification/reset emails are skipped and the app still works.
RESEND_API_KEY=
# Public URL of the app, used in email links (set to your deployed URL).
APP_URL=http://localhost:5000
# Optional: a verified sender. In Resend test mode, onboarding@resend.dev works.
EMAIL_FROM=Todo App Pro <onboarding@resend.dev>
